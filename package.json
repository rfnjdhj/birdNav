{
  "name": "birdnav",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "mybuild": "vite build --base=https://cdn.jsdelivr.net/gh/CrazyBoyM/birdNav/dist/",
    "serve": "vite preview",
    "prepare": "husky install",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@icon-park/react": "^1.3.5",
    "localforage": "^1.10.0",
    "nanoid": "^3.2.0",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "vue-jsonp": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^16.10.3",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@vitejs/plugin-react": "^1.0.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/jest-dom": "^5.16.5",
    "vitest": "^0.34.6",
    "jsdom": "^23.0.1",
    "husky": "^7.0.4",
    "lint-staged": "^12.3.1",
    "prettier": "2.5.1",
    "typescript": "^4.3.2",
    "vite": "^2.6.4",
    "vite-plugin-html": "^2.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{css,json,md}": ["prettier --write"]
  }
}
